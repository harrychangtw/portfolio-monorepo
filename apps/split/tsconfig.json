{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "ES2020",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@portfolio/config": ["../../packages/config"],
      "@portfolio/config/*": ["../../packages/config/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
